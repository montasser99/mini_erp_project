{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4a3b-8c1d-0e1f2a3b4c5d",
    "name": "Mini ERP Stock API - Montasser Benouirane",
    "description": "Suite de tests API pour le Mini ERP de gestion de stock multi-entrepôts.\n\nStack : Laravel 12 + Sanctum + MySQL\nEndpoints testés :\n- POST /api/login\n- POST /api/movements (IN, OUT, TRANSFER, Erreur négatif)\n- GET /api/stock (avec filtres productId et warehouseId)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentification",
      "item": [
        {
          "name": "Connexion (Génération Token Bearer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token généré avec succès\", function () {",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"token\", jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@erp.com\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Consultation du Stock (GET /stock)",
      "item": [
        {
          "name": "GET /stock (Tous les stocks)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock"]
            }
          }
        },
        {
          "name": "GET /stock filtré (?productId=1&warehouseId=1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Stock retourné avec relations\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock?productId=1&warehouseId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock"],
              "query": [
                {
                  "key": "productId",
                  "value": "1"
                },
                {
                  "key": "warehouseId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03. Mouvements de Stock (POST /movements)",
      "item": [
        {
          "name": "1. Entrée de stock (IN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Mouvement enregistré\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.type).to.eql(\"IN\");",
                  "    pm.expect(json.data.quantity).to.eql(25);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"warehouse_id\": 1,\n    \"type\": \"IN\",\n    \"quantity\": 25,\n    \"reference\": \"POSTMAN-IN-001\",\n    \"notes\": \"Test entrée Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movements"]
            }
          }
        },
        {
          "name": "2. Sortie de stock autorisée (OUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"warehouse_id\": 1,\n    \"type\": \"OUT\",\n    \"quantity\": 5,\n    \"reference\": \"POSTMAN-OUT-001\",\n    \"notes\": \"Expédition validée\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movements"]
            }
          }
        },
        {
          "name": "3. REJET Stock Négatif (OUT impossible)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Erreur stock insuffisant détectée\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errors.quantity).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"warehouse_id\": 1,\n    \"type\": \"OUT\",\n    \"quantity\": 999999,\n    \"reference\": \"TEST-FAIL-001\",\n    \"notes\": \"Doit échouer car quantité > stock\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movements"]
            }
          }
        },
        {
          "name": "4. Transfert Inter-Entrepôts (TRANSFER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Transfert validé\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.type).to.eql(\"TRANSFER\");",
                  "    pm.expect(json.data.destination_warehouse_id).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"warehouse_id\": 1,\n    \"type\": \"TRANSFER\",\n    \"quantity\": 10,\n    \"destination_warehouse_id\": 2,\n    \"reference\": \"POSTMAN-TR-001\",\n    \"notes\": \"Transfert Paris vers Lyon\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "movements"]
            }
          }
        }
      ]
    }
  ]
}
